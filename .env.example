# IPTVPilot configuration template. Copy to .env and replace all placeholders.

# NAS 存储路径。推荐 DB/搜索索引/模型放 NVMe，录制/备份放机械盘。
MONGODB_DATA_PATH=/nas/iptv/db
MONGOT_DATA_PATH=/nas/iptv/db-search
RECORDINGS_PATH=/nas/iptv/recordings
MEDIA_CACHE_PATH=/nas/iptv/media-cache
MODELS_PATH=/nas/iptv/models
M3U_DATA_PATH=/nas/iptv/m3u
BACKUP_PATH=/nas/iptv/backup
TZ=Asia/Shanghai
LOG_LEVEL=INFO
IPTV_PILOT_IMAGE=iptv-pilot
APP_TAG=local

# MongoDB 8.2+ / 单节点副本集
MONGODB_SERVER_TAG=8.2.0-ubi9
MONGOT_TAG=latest
MONGODB_DATABASE=iptv_pilot
IPTV_DB_USER=iptv_user
IPTV_DB_PASSWORD=change-me-iptv
MONGOT_PASSWORD=change-me-mongot
MONGODB_URI=mongodb://iptv_user:change-me-iptv@mongodb:27017/iptv_pilot?authSource=iptv_pilot&replicaSet=rs0

# EPG sources, comma-separated. Only the local iptv-api output is configured by default.
EPG_URLS=/data/m3u/epg/epg.xml
EPG_REFRESH_MINUTES=30
EPG_REQUEST_TIMEOUT=90

# iptv-api（官方镜像实际名称为 guovern/iptv-api）
IPTV_API_IMAGE=guovern/iptv-api:latest
IPTV_API_CONFIG_PATH=/nas/iptv/iptv-api-config
IPTV_API_PUBLIC_DOMAIN=127.0.0.1
IPTV_API_PUBLIC_PORT=5181
IPTV_API_IPV_TYPE=ipv4
IPTV_API_IPV_TYPE_PREFER=ipv4
M3U_PATH=/data/m3u/result.m3u
CHANNEL_SYNC_INTERVAL_SECONDS=300
STREAM_QUALITY_INTERVAL_SECONDS=3600
STREAM_QUALITY_SAMPLE_COUNT=2
STREAM_QUALITY_TIMEOUT_SECONDS=20
STREAM_QUALITY_WORKERS=3
LIVE_NORMALIZE_CHANNELS=
LIVE_NORMALIZE_MAX_CHANNELS=2
LIVE_NORMALIZE_WIDTH=1280
LIVE_NORMALIZE_HEIGHT=720
LIVE_NORMALIZE_FPS=25
LIVE_NORMALIZE_VIDEO_BITRATE=3500k
LIVE_NORMALIZE_VIDEO_MAXRATE=4000k
LIVE_NORMALIZE_VIDEO_BUFSIZE=8000k
LIVE_NORMALIZE_HLS_LIST_SIZE=30
LIVE_NORMALIZE_HLS_DELETE_THRESHOLD=10
LIVE_NORMALIZE_STALE_SECONDS=60
LIVE_NORMALIZE_PUBLISH_INTERVAL=2
LIVE_NORMALIZE_PUBLISH_PREBUFFER=10
LIVE_NORMALIZE_MAX_INVALID_SEGMENTS=5
LIVE_NORMALIZE_MAX_AV_DRIFT_SECONDS=3
LIVE_NORMALIZE_MAX_TRACK_DURATION_SECONDS=4.5

# 调度与录制
SCHEDULER_INTERVAL_SECONDS=60
SCHEDULER_HORIZON_MINUTES=15
RECORDING_POLL_SECONDS=5
RECORDING_PRE_ROLL_SECONDS=60
RECORDING_POST_ROLL_SECONDS=180
RECORDING_MIN_BYTES=1048576
RECORDING_MAX_RETRIES=2
RECORDING_STALE_SECONDS=600
RECORDING_RETENTION_DAYS=30
FFMPEG_BIN=auto

# AI features are disabled by default for a smaller first build.
INSTALL_AI_DEPS=0
INSTALL_FFMPEG=1
INSTALL_EMBEDDING_DEPS=0
PYPI_INDEX_URL=https://pypi.org/simple
DEBIAN_MIRROR=https://deb.debian.org
ASR_BACKEND=mock
ASR_MODEL=small
ASR_COMPUTE_TYPE=int8
ASR_DEVICE=cpu
ASR_POLL_SECONDS=10
ASR_MAX_RETRIES=2
ASR_STALE_SECONDS=600
ASR_LANGUAGE=
# Optional proxy used only while downloading models.
MODEL_HTTP_PROXY=
MODEL_NO_PROXY=localhost,127.0.0.1,mongodb,mongot
# BGE-M3 约 2.3GB；启用时同时设置 INSTALL_EMBEDDING_DEPS=1。
EMBEDDING_BACKEND=none
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIMENSIONS=1024

# LLM Provider：ark / openai / custom / mock（DeepSeek 使用 custom；mock 仅用于冒烟测试）
LLM_PROVIDER=mock
LLM_MODEL=doubao-seed-1-6-250615
LLM_API_KEY=
LLM_BASE_URL=
ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MAX_INPUT_CHARS=60000
LLM_POLL_SECONDS=10
LLM_MAX_RETRIES=2
LLM_TIMEOUT_SECONDS=90
LLM_STALE_SECONDS=300

# Notifications are disabled by default. Set PUSH_PROVIDER=email after configuring SMTP.
PUSH_PROVIDER=none
PUSH_EMAIL_MODE=fallback
PUSH_POLL_SECONDS=10
PUSH_MAX_RETRIES=3
COZE_BOT_ID=
COZE_API_TOKEN=
COZE_API_BASE=https://api.coze.cn
COZE_USER_ID=iptv_pilot
COZE_TIMEOUT_SECONDS=30
SMTP_HOST=
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=
SMTP_USE_SSL=true

# Web 管理台
WEB_HOST=0.0.0.0
WEB_PORT=5190
WEB_CORS_ORIGINS=http://localhost:5190
# API 暴露到公网或隧道时必须设置随机长令牌；为空仅适合可信局域网。
WEB_API_TOKEN=
MEDIA_CACHE_MAX_BYTES=21474836480
MEDIA_REMUX_TIMEOUT_SECONDS=300
LIVE_PROXY_TIMEOUT_SECONDS=20
LIVE_TOKEN_TTL_SECONDS=900

# 备份
BACKUP_RETENTION_DAYS=14
